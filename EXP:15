#include <stdio.h>

#define SIZE 10

int hashTable[SIZE];

void initialize()
{
    int i;
    for (i = 0; i < SIZE; i++)
        hashTable[i] = -1;
}

void insert(int key)
{
    int index = key % SIZE;

    while (hashTable[index] != -1)
        index = (index + 1) % SIZE;

    hashTable[index] = key;
}

void display()
{
    int i;

    printf("Hash Table:\n");
    for (i = 0; i < SIZE; i++)
        printf("%d : %d\n", i, hashTable[i]);
}

int main()
{
    int n, key, i;

    initialize();

    printf("Enter number of keys: ");
    scanf("%d", &n);

    printf("Enter keys:\n");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &key);
        insert(key);
    }

    display();

    return 0;
}
