#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int key,h;
    struct Node *l,*r;
} Node;

int height(Node *n) {
    return n?n->h:0;
}

int max(int a,int b) {
    return a>b?a:b;
}

Node* newNode(int x) {
    Node *n=malloc(sizeof(Node));
    n->key=x; n->h=1;
    n->l=n->r=NULL;
    return n;
}

Node* right(Node *y) {
    Node *x=y->l,*t=x->r;
    x->r=y; y->l=t;
    y->h=1+max(height(y->l),height(y->r));
    x->h=1+max(height(x->l),height(x->r));
    return x;
}

Node* left(Node *x) {
    Node *y=x->r,*t=y->l;
    y->l=x; x->r=t;
    x->h=1+max(height(x->l),height(x->r));
    y->h=1+max(height(y->l),height(y->r));
    return y;
}

int balance(Node *n) {
    return n?height(n->l)-height(n->r):0;
}

Node* insert(Node *n,int x) {
    if(!n) return newNode(x);

    if(x<n->key) n->l=insert(n->l,x);
    else if(x>n->key) n->r=insert(n->r,x);
    else return n;

    n->h=1+max(height(n->l),height(n->r));

    if(balance(n)>1 && x<n->l->key) return right(n);
    if(balance(n)<-1 && x>n->r->key) return left(n);

    if(balance(n)>1 && x>n->l->key) {
        n->l=left(n->l);
        return right(n);
    }

    if(balance(n)<-1 && x<n->r->key) {
        n->r=right(n->r);
        return left(n);
    }

    return n;
}

Node* minimum(Node *n) {
    while(n->l) n=n->l;
    return n;
}

Node* delete(Node *n,int x) {
    if(!n) return n;

    if(x<n->key) n->l=delete(n->l,x);
    else if(x>n->key) n->r=delete(n->r,x);
    else {
        if(!n->l || !n->r) {
            Node *t=n->l?n->l:n->r;
            if(!t) return NULL;
            *n=*t;
        } else {
            Node *t=minimum(n->r);
            n->key=t->key;
            n->r=delete(n->r,t->key);
        }
    }

    n->h=1+max(height(n->l),height(n->r));

    if(balance(n)>1 && balance(n->l)>=0) return right(n);
    if(balance(n)>1) {
        n->l=left(n->l);
        return right(n);
    }
    if(balance(n)<-1 && balance(n->r)<=0) return left(n);
    if(balance(n)<-1) {
        n->r=right(n->r);
        return left(n);
    }

    return n;
}

void search(Node *n,int x) {
    if(!n) {
        printf("Not Found\n");
        return;
    }
    if(n->key==x) printf("Found\n");
    else if(x<n->key) search(n->l,x);
    else search(n->r,x);
}

void inorder(Node *n) {
    if(n) {
        inorder(n->l);
        printf("%d ",n->key);
        inorder(n->r);
    }
}

int main() {
    Node *root=NULL;
    int ch,x;

    while(1) {
        printf("\n1.Insert 2.Delete 3.Search 4.Display 5.Exit\n");
        scanf("%d",&ch);

        if(ch==1) {
            scanf("%d",&x);
            root=insert(root,x);
        }
        else if(ch==2) {
            scanf("%d",&x);
            root=delete(root,x);
        }
        else if(ch==3) {
            scanf("%d",&x);
            search(root,x);
        }
        else if(ch==4) {
            inorder(root);
        }
        else break;
    }
    return 0;
}
