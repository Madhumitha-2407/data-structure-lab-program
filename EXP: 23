#include <stdio.h>
#define INF 9999

int main() {
    int a[10][10],d[10],v[10]={0};
    int n,i,j,s,u,min;

    scanf("%d",&n);

    for(i=0;i<n;i++)
        for(j=0;j<n;j++)
            scanf("%d",&a[i][j]);

    scanf("%d",&s);

    for(i=0;i<n;i++) d[i]=INF;
    d[s]=0;

    for(i=0;i<n;i++) {
        min=INF;

        for(j=0;j<n;j++)
            if(!v[j] && d[j]<min)
                min=d[j],u=j;

        v[u]=1;

        for(j=0;j<n;j++)
            if(a[u][j] && d[j]>d[u]+a[u][j])
                d[j]=d[u]+a[u][j];
    }

    for(i=0;i<n;i++)
        printf("%d -> %d\n",i,d[i]);

    return 0;
}
